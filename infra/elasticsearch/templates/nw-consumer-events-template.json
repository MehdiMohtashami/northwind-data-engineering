{
  "index_patterns": ["nw-consumer-events-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "op": { "type": "keyword" },
        "table": { "type": "keyword" },
        "order_id": { "type": "integer" },
        "product_id": { "type": "integer" },
        "lsn": { "type": "keyword" },
        "event_ts": { "type": "date" },
        "processed_ts": { "type": "date" },
        "latency_ms": { "type": "float" },
        "status": { "type": "keyword" },
        "error": { "type": "text" }
      }
    }
  }
}
