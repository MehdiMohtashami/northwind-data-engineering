            {
              "type": "date_histogram",
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "timeFrom": "24h"
    }
  ],
  "liveNow": true
}
