      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT bucket_time AS time, sum(freight) OVER (ORDER BY bucket_time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"Total Freight\" FROM (SELECT toStartOfMonth(min_od) AS bucket_time, sum(freight) AS freight FROM (SELECT OrderID, any(OrderDate) AS min_od, any(Freight) AS freight FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY OrderID) GROUP BY bucket_time ORDER BY bucket_time) ORDER BY bucket_time"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Revenue Growth YoY % (CY1997 vs CY1996)",
      "description": "1996 is a partial year (Northwind data starts 1996-07), so this is not a like-for-like 12-vs-12-month comparison.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF9830"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-northwinddw"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT round(100.0 * (rev1997 - rev1996) / rev1996, 2) AS \"YoY Growth\" FROM (SELECT sumIf(LineTotal, OrderYear=1997) AS rev1997, sumIf(LineTotal, OrderYear=1996) AS rev1996 FROM v_FactOrders_Flat)"
        }
      ]
    },
