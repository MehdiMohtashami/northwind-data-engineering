          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT bucket_time AS time, sum(qty) OVER (ORDER BY bucket_time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"Total Quantity\" FROM (SELECT toStartOfMonth(OrderDate) AS bucket_time, sum(Quantity) AS qty FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY bucket_time ORDER BY bucket_time) ORDER BY bucket_time"
