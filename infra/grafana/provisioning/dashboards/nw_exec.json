        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-northwinddw"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 0,
          "rawSql": "WITH (SELECT uniqExact(OrderID) FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate)) AS total_orders SELECT bucket_time AS time, cum_rev / total_orders AS \"Avg Order Value\" FROM (SELECT bucket_time, sum(revenue) OVER (ORDER BY bucket_time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_rev FROM (SELECT toStartOfMonth(OrderDate) AS bucket_time, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY bucket_time ORDER BY bucket_time)) ORDER BY bucket_time"
        }
      ]
    },
    {
