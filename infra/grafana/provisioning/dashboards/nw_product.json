{
  "uid": "nw-product-category",
  "title": "Northwind - Product & Category Performance",
  "tags": ["northwind", "product"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "graphTooltip": 1,
  "time": { "from": "1996-01-01T00:00:00.000Z", "to": "1998-12-31T00:00:00.000Z" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Distinct Products Sold",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#73BF69" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/" }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "value" },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT fmt_int(uniqExact(ProductID)) AS \"Distinct Products\" FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate)" }]
    },
    {
      "id": 2, "type": "stat", "title": "Total Units Sold",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#73BF69" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/" }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "value" },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT fmt_int(sum(Quantity)) AS \"Total Units Sold\" FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate)" }]
    },
    {
      "id": 3, "type": "stat", "title": "Top Category",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#FF9830" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/" }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "value" },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT CategoryName AS \"Top Category\" FROM (SELECT CategoryName, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY CategoryName ORDER BY revenue DESC LIMIT 1)" }]
    },
    {
      "id": 4, "type": "stat", "title": "Top Product",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#FF9830" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/" }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "value" },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT ProductName AS \"Top Product\" FROM (SELECT ProductName, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY ProductName ORDER BY revenue DESC LIMIT 1)" }]
    },
    {
      "id": 5, "type": "barchart", "title": "Revenue by Category",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#5794F2" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "showValue": "always", "legend": { "showLegend": false } },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT CategoryName, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY CategoryName ORDER BY revenue ASC" }]
    },
    {
      "id": 6, "type": "barchart", "title": "Top 10 Products by Revenue",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#5794F2" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "showValue": "always", "legend": { "showLegend": false } },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT ProductName, revenue FROM (SELECT ProductName, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY ProductName ORDER BY revenue DESC LIMIT 10) ORDER BY revenue ASC" }]
    },
    {
      "id": 7, "type": "barchart", "title": "Units Sold by Category",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#73BF69" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "showValue": "always", "legend": { "showLegend": false } },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT CategoryName, sum(Quantity) AS units FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY CategoryName ORDER BY units ASC" }]
    },
    {
      "id": 8, "type": "barchart", "title": "Avg Discount % by Category",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "#FF9830" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "showValue": "always", "legend": { "showLegend": false } },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT CategoryName, avg(Discount) AS avg_discount FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY CategoryName ORDER BY avg_discount ASC" }]
    }
  ]
}
