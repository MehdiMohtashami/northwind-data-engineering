      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 0,
          "rawSql": "WITH first_seen AS (SELECT CategoryName, min(toStartOfMonth(OrderDate)) AS fm FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) AND CategoryName IS NOT NULL GROUP BY CategoryName) SELECT fm AS time, sum(cnt) OVER (ORDER BY fm ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"Categories\" FROM (SELECT fm, count() AS cnt FROM first_seen GROUP BY fm ORDER BY fm) ORDER BY fm"
        }
      ]
