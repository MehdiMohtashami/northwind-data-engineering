        "textMode": "value"
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-northwinddw"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 0,
          "rawSql": "WITH first_seen AS (SELECT EmployeeID, min(toStartOfMonth(OrderDate)) AS fm FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY EmployeeID) SELECT fm AS time, sum(cnt) OVER (ORDER BY fm ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"Distinct Employees\" FROM (SELECT fm, count() AS cnt FROM first_seen GROUP BY fm ORDER BY fm) ORDER BY fm"
        }
      ]
    },
    {
      "id": 2,
