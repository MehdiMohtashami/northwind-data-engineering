            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT EmployeeName AS \"Top Performer\" FROM (SELECT EmployeeName, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY EmployeeName ORDER BY revenue DESC LIMIT 1)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg Revenue per Employee",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#37872D"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-northwinddw"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 0,
          "rawSql": "WITH (SELECT uniqExact(EmployeeID) FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate)) AS total_employees SELECT bucket_time AS time, cum_rev / total_employees AS \"Avg Revenue per Employee\" FROM (SELECT bucket_time, sum(revenue) OVER (ORDER BY bucket_time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_rev FROM (SELECT toStartOfMonth(OrderDate) AS bucket_time, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY bucket_time ORDER BY bucket_time)) ORDER BY bucket_time"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "% Orders Shipped",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#37872D"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-northwinddw"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT bucket_time AS time, 100.0 * sum(shipped) OVER (ORDER BY bucket_time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) / sum(total) OVER (ORDER BY bucket_time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"% Shipped\" FROM (SELECT toStartOfMonth(od.FullDate) AS bucket_time, countIf(t.shipped_dk IS NOT NULL) AS shipped, count() AS total FROM (SELECT OrderID, any(OrderDateKey) AS order_dk, any(ShippedDateKey) AS shipped_dk FROM FactOrders FINAL WHERE is_deleted = 0 GROUP BY OrderID) t INNER JOIN DimDate od ON t.order_dk = od.DateKey WHERE $__timeFilter(od.FullDate) GROUP BY bucket_time ORDER BY bucket_time) ORDER BY bucket_time"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg Days to Ship",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8E8E8E"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-northwinddw"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT bucket_time AS time, sum(days_sum) OVER (ORDER BY bucket_time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) / sum(shipped_cnt) OVER (ORDER BY bucket_time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"Avg Days to Ship\" FROM (SELECT toStartOfMonth(od.FullDate) AS bucket_time, sum(dateDiff('day', od.FullDate, sd.FullDate)) AS days_sum, count() AS shipped_cnt FROM (SELECT OrderID, any(OrderDateKey) AS order_dk, any(ShippedDateKey) AS shipped_dk FROM FactOrders FINAL WHERE is_deleted = 0 GROUP BY OrderID) t INNER JOIN DimDate od ON t.order_dk = od.DateKey INNER JOIN DimDate sd ON t.shipped_dk = sd.DateKey WHERE t.shipped_dk IS NOT NULL AND $__timeFilter(od.FullDate) GROUP BY bucket_time ORDER BY bucket_time) ORDER BY bucket_time"
        }
      ]
    },
