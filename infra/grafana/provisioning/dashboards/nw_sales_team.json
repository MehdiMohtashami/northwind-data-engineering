          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT countIf(t.shipped_dk IS NOT NULL) AS Shipped, countIf(t.shipped_dk IS NULL) AS Pending FROM (SELECT OrderID, any(OrderDateKey) AS order_dk, any(ShippedDateKey) AS shipped_dk FROM FactOrders FINAL WHERE is_deleted = 0 GROUP BY OrderID) t INNER JOIN DimDate od ON t.order_dk = od.DateKey WHERE $__timeFilter(od.FullDate)"
