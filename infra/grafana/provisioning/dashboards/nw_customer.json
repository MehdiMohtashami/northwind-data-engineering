          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-northwinddw"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT CustomerName AS \"Top Customer\" FROM (SELECT CustomerName, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY CustomerName ORDER BY revenue DESC LIMIT 1)"
        }
      ]
    },
