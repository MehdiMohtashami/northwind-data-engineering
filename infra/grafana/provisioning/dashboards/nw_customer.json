  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Distinct Customers",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3274D9"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-northwinddw"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 0,
          "rawSql": "WITH first_seen AS (SELECT CustomerID, min(toStartOfMonth(OrderDate)) AS fm FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY CustomerID) SELECT fm AS time, sum(cnt) OVER (ORDER BY fm ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"Distinct Customers\" FROM (SELECT fm, count() AS cnt FROM first_seen GROUP BY fm ORDER BY fm) ORDER BY fm"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg Revenue per Customer",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#37872D"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-northwinddw"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 0,
          "rawSql": "WITH (SELECT uniqExact(CustomerID) FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate)) AS total_customers SELECT bucket_time AS time, cum_rev / total_customers AS \"Avg Revenue per Customer\" FROM (SELECT bucket_time, sum(revenue) OVER (ORDER BY bucket_time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_rev FROM (SELECT toStartOfMonth(OrderDate) AS bucket_time, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY bucket_time ORDER BY bucket_time)) ORDER BY bucket_time"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Top Customer",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
