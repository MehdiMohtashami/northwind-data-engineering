{
  "uid": "nw-customer-geography",
  "title": "Northwind - Customer & Geography",
  "tags": ["northwind", "customer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "graphTooltip": 1,
  "time": { "from": "1996-01-01T00:00:00.000Z", "to": "1998-12-31T00:00:00.000Z" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Distinct Customers",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#73BF69" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/" }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "value" },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT fmt_int(uniqExact(CustomerID)) AS \"Distinct Customers\" FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate)" }]
    },
    {
      "id": 2, "type": "stat", "title": "Avg Revenue per Customer",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "#5794F2" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/" }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "value" },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT sum(LineTotal) / uniqExact(CustomerID) AS \"Avg Revenue per Customer\" FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate)" }]
    },
    {
      "id": 3, "type": "stat", "title": "Top Customer",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#FF9830" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/" }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "value" },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT CustomerName AS \"Top Customer\" FROM (SELECT CustomerName, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY CustomerName ORDER BY revenue DESC LIMIT 1)" }]
    },
    {
      "id": 4, "type": "stat", "title": "Top Country",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#FF9830" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/" }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "value" },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT ShipCountry AS \"Top Country\" FROM (SELECT ShipCountry, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY ShipCountry ORDER BY revenue DESC LIMIT 1)" }]
    },
    {
      "id": 5, "type": "barchart", "title": "Revenue by Country (Top 10)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#5794F2" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "showValue": "always", "legend": { "showLegend": false } },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT ShipCountry, revenue FROM (SELECT ShipCountry, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY ShipCountry ORDER BY revenue DESC LIMIT 10) ORDER BY revenue ASC" }]
    },
    {
      "id": 6, "type": "barchart", "title": "Top 10 Customers by Revenue",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#5794F2" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "showValue": "always", "legend": { "showLegend": false } },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT CustomerName, revenue FROM (SELECT CustomerName, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY CustomerName ORDER BY revenue DESC LIMIT 10) ORDER BY revenue ASC" }]
    },
    {
      "id": 7, "type": "barchart", "title": "Revenue by Region (Top 10, where recorded)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#5794F2" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "showValue": "always", "legend": { "showLegend": false } },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT ShipRegion, revenue FROM (SELECT ShipRegion, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) AND ShipRegion IS NOT NULL GROUP BY ShipRegion ORDER BY revenue DESC LIMIT 10) ORDER BY revenue ASC" }]
    },
    {
      "id": 8, "type": "barchart", "title": "Number of Customers by Country (Top 10)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#73BF69" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "showValue": "always", "legend": { "showLegend": false } },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" },
      "targets": [{ "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-northwinddw" }, "queryType": "sql", "editorType": "sql", "format": 1,
        "rawSql": "SELECT ShipCountry, customers FROM (SELECT ShipCountry, uniqExact(CustomerID) AS customers FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY ShipCountry ORDER BY customers DESC LIMIT 10) ORDER BY customers ASC" }]
    }
  ]
}
