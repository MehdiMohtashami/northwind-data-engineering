      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-northwinddw"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-northwinddw"
          },
          "queryType": "sql",
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT CASE ShipCountry WHEN 'Argentina' THEN 'ARG' WHEN 'Austria' THEN 'AUT' WHEN 'Belgium' THEN 'BEL' WHEN 'Brazil' THEN 'BRA' WHEN 'Canada' THEN 'CAN' WHEN 'Denmark' THEN 'DNK' WHEN 'Finland' THEN 'FIN' WHEN 'France' THEN 'FRA' WHEN 'Germany' THEN 'DEU' WHEN 'Ireland' THEN 'IRL' WHEN 'Italy' THEN 'ITA' WHEN 'Mexico' THEN 'MEX' WHEN 'Norway' THEN 'NOR' WHEN 'Poland' THEN 'POL' WHEN 'Portugal' THEN 'PRT' WHEN 'Spain' THEN 'ESP' WHEN 'Sweden' THEN 'SWE' WHEN 'Switzerland' THEN 'CHE' WHEN 'UK' THEN 'GBR' WHEN 'USA' THEN 'USA' WHEN 'Venezuela' THEN 'VEN' ELSE 'unknown' END AS iso3, sum(LineTotal) AS revenue FROM v_FactOrders_Flat WHERE $__timeFilter(OrderDate) GROUP BY iso3"
        }
      ]
    },
